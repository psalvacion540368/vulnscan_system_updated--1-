# Copy to .env and fill in for your environment (do not commit the real .env)

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HTTPS=False

# Set to False to use MySQL (e.g. via XAMPP). Set to True for a quick
# zero-config SQLite run while you're setting MySQL up.
VULNSCAN_USE_SQLITE=True

# MySQL (Data Persistence Layer) -- ignored if VULNSCAN_USE_SQLITE=True
# Create these via phpMyAdmin's SQL tab first:
#   CREATE DATABASE vulnscan_db CHARACTER SET utf8mb4;
#   CREATE USER 'vulnscan_app'@'localhost' IDENTIFIED BY 'YourPassword123!';
#   GRANT ALL PRIVILEGES ON vulnscan_db.* TO 'vulnscan_app'@'localhost';
#   FLUSH PRIVILEGES;
DB_NAME=vulnassess_db
DB_USER=vulnassess_app
DB_PASSWORD=YourPassword123!
DB_HOST=127.0.0.1
DB_PORT=3306

# Scanning engine
# Full path to nmap.exe if it's not on your system PATH, e.g.:
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
NMAP_PATH=/usr/bin/nmap
SCAN_DEFAULT_TIMEOUT_SECONDS=600
SCAN_MAX_CONCURRENT_JOBS=2

# Comma-separated CIDRs/IPs this deployment is authorized to scan.
# Leave blank to default to RFC1918 private ranges + loopback only.
SCAN_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# Comma-separated hostnames/domains this deployment is authorized to scan as
# web targets (subdomains of a listed domain are also allowed). Empty = no
# web targets allowed until you add some here. Only add domains you own or
# have explicit written authorization to test -- e.g. scanme.nmap.org is
# publicly provided by the Nmap project specifically for testing scanners.
SCAN_ALLOWED_DOMAINS=scanme.nmap.org

# Vulnerability correlation engine
NVD_API_KEY=
